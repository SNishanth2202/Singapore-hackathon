# =========================================================
# Singtel Scout — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# =========================================================

# --- Server ---
NODE_ENV=development
PORT=5000
API_VERSION=v1

# --- MongoDB ---
STORAGE_MODE=cloud
LOCAL_DEMO_MODE=false
HOST=127.0.0.1
TRUST_PROXY_HOPS=0
MONGODB_URI=mongodb+srv://<database-user>:<url-encoded-password>@<cluster>.mongodb.net/
MONGODB_DB_NAME=enterprise_radar

# --- Neo4j ---
NEO4J_URI=neo4j+s://<database-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# --- JWT ---
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# --- CORS ---
CORS_ORIGIN=http://localhost:3000

# --- Logging ---
LOG_LEVEL=info

# FreeLLMAPI (backend only; copy the unified key locally into .env)
FREELLMAPI_BASE_URL=http://127.0.0.1:31415/v1
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto
FREELLMAPI_TIMEOUT_MS=45000

# Hosted AI router (backend only). When using these settings, provide all three.
# Leave commented to keep the existing Desktop provider during local development.
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=
# AI_MODEL=nvidia/nemotron-3.5-lightning:free
# AI_PROTOCOL=chat_completions
# AI_MODELS_URL=https://openrouter.ai/api/v1/models
# AI_TIMEOUT_MS=90000
# AI_REASONING_EFFORT=none
AI_REQUESTS_PER_MINUTE=6

# Lead ranking uses synthetic CRM and engineering facts with an isolated JSON store.
# Active OpenAI ranking defaults to gpt-4.1-mini. Without a key, the UI opens a key popup.
# Backend only; never use a VITE_ variable for a key. Set LEAD_RANKING_MODE=rules for offline reference mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Frozen replay by default. Enable real clock checks only when desired.
DEMO_REAL_CLOCK=false
# Container only: bind all interfaces; local default is 127.0.0.1.
# HOST=0.0.0.0

# Sales Communication Agent settings (backend only; never use VITE_ for secrets)
SALES_EMAIL_PROVIDER=mock
SALES_FOLLOWUP_DELAY_DAYS=5
SALES_MAX_FOLLOWUPS=2
SALES_API_TOKEN=
SALES_EMAIL_WEBHOOK_SECRET=
# AI Management sends and reads mail through the same provider. Polling needs read access:
# Gmail OAuth (scopes gmail.send + gmail.readonly): GMAIL_CLIENT_ID, GMAIL_CLIENT_SECRET, GMAIL_REFRESH_TOKEN
# Microsoft OAuth (Mail.Send, Mail.ReadWrite, Mail.Read, offline_access): MICROSOFT_TENANT_ID, MICROSOFT_CLIENT_ID, MICROSOFT_CLIENT_SECRET, MICROSOFT_REFRESH_TOKEN
# Daily target, schedule, follow-up policy and the emergency stop are configured in the app (AI Management > Settings), not here.