# =========================================================
# Enterprise Radar AI — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# =========================================================

# --- Server ---
NODE_ENV=development
PORT=5000
API_VERSION=v1

# --- MongoDB ---
MONGODB_URI=mongodb://mongo:27017/enterprise_radar
MONGODB_DB_NAME=enterprise_radar

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# --- JWT ---
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# --- CORS ---
CORS_ORIGIN=http://localhost:3000

# --- Logging ---
LOG_LEVEL=info

# Lead-ranking demo: database and JWT settings above are for the legacy app.
# The demo uses .local/lead-ranking-state.json and needs no credentials.
# Optional live LLM extraction (both values must be supplied to enable it):
OPENAI_API_KEY=
OPENAI_MODEL=
# Frozen replay by default. Enable real clock checks only when desired.
DEMO_REAL_CLOCK=false
# Container only: bind all interfaces; local default is 127.0.0.1.
# HOST=0.0.0.0
