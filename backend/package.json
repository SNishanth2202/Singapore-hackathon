{
  "name": "enterprise-radar-backend",
  "version": "1.0.0",
  "description": "Enterprise Radar AI — Backend API (Singtel Hackathon)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/ranking/demo-server.ts",
    "dev:legacy": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/ranking/demo-server.js",
    "start:legacy": "node dist/server.js",
    "seed:lead-ranking": "ts-node src/scripts/seed-lead-ranking.ts",
    "test:ranking": "node -r ts-node/register/transpile-only --test test/ranking.test.ts test/api.test.ts test/importer.test.ts",
    "verify:ranking-demo": "ts-node src/scripts/verify-ranking-demo.ts",
    "seed": "ts-node src/scripts/seed.ts",
    "lint": "eslint src --ext .ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "neo4j-driver": "^5.21.0",
    "pino": "^9.2.0",
    "pino-http": "^10.2.0",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
