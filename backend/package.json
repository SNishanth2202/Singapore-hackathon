{
  "name": "enterprise-radar-backend",
  "version": "1.0.0",
  "description": "Enterprise Radar AI — Backend API (Singtel Hackathon)",
  "main": "dist/server.js",
  "scripts": {
    "test": "npm run build && node --test --test-concurrency=2 tests/*.test.cjs && node -r ts-node/register/transpile-only --test --test-concurrency=2 test/*.test.ts",
    "refresh:crm": "ts-node src/scripts/refresh-crm-portfolio.ts",
    "seed:crm": "ts-node src/scripts/seed-crm.ts",
    "seed:showcase": "ts-node src/scripts/seed-showcase.ts",
    "test:product-fixes": "npm run build && node --test tests/product-fixes.test.cjs",
    "showcase": "ts-node --transpile-only src/scripts/showcase.ts",
    "ingest:customer-graph": "ts-node src/scripts/ingest-customer-graph.ts",
    "test:customer-graph": "node -r ts-node/register/transpile-only --test test/customer-graph.test.ts",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc --project tsconfig.json",
    "test:ai-management": "npm run build && node --test tests/ai-management.test.cjs tests/ai-management-e2e.test.cjs tests/ai-management-restart.test.cjs",
    "test:ai": "npm run build && node --test tests/freellmapi.test.cjs",
    "test:research": "npm run build && node --test tests/research.test.cjs tests/freellmapi.test.cjs tests/business.test.cjs tests/events.test.cjs",
    "test:business": "npm run build && node --test tests/business.test.cjs",
    "test:deployment": "npm run build && node --test tests/deployment.test.cjs",
    "test:storage": "npm run build && node --test tests/storage.test.cjs",
    "check:deployment": "npm run build && node dist/scripts/check-deployment.js",
    "verify:cloud": "npm run build && node dist/scripts/verify-cloud.js",
    "verify:ai": "npm run build && node dist/scripts/verify-ai.js",
    "preview:local": "npm run build && node dist/scripts/preview.js",
    "start": "node dist/server.js",
    "seed": "ts-node src/scripts/seed.ts",
    "lint": "tsc --noEmit --project tsconfig.json",
    "seed:lead-ranking": "ts-node src/scripts/seed-lead-ranking.ts",
    "test:ranking": "node -r ts-node/register/transpile-only --test test/salesperson.test.ts test/ranking.test.ts test/api.test.ts test/importer.test.ts test/discovery-handoff.test.ts test/llm-ranking.test.ts test/customer-eligibility.test.ts",
    "test:sales": "npm run build && node --test tests/sales-agents.test.cjs",
    "verify:ranking-demo": "ts-node src/scripts/verify-ranking-demo.ts",
    "dev:ranking-demo": "ts-node-dev --respawn --transpile-only src/ranking/demo-server.ts",
    "start:ranking-demo": "node dist/ranking/demo-server.js",
    "dev:preview": "ts-node-dev --respawn --transpile-only src/scripts/preview.ts",
    "test:prospecting": "npm run build && node -r ts-node/register/transpile-only --test test/prospecting.test.ts test/prospecting-api.test.ts",
    "start:research-worker": "node dist/scripts/prospecting-worker.js"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.4",
    "fast-xml-parser": "^5.12.0",
    "helmet": "^7.1.0",
    "ipaddr.js": "^2.5.0",
    "mongoose": "^8.4.1",
    "neo4j-driver": "^5.21.0",
    "winston": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
